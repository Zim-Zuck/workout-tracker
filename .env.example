# Copy to .env and fill in from Supabase → Project Settings → API.
# Only the anon/public key belongs here. The service_role key must NEVER
# appear in this repo or in any client bundle — it bypasses row-level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
